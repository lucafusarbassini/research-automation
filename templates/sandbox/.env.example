# ricet Sandbox configuration
# Copy this to .env and adjust values:  cp .env.example .env

# How many hours the sandbox should run before auto-shutdown (default: 10)
SANDBOX_TIMEOUT_HOURS=10

# Container name (used in scripts and docker exec commands)
CONTAINER_NAME=ricet-sandbox

# Workspace bind mount path (set by ricet setup; makes files visible to VS Code)
# WORKSPACE_PATH=./workspace
